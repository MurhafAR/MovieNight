# NextAuth / Google OAuth
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
AUTH_SECRET=generate-with: openssl rand -base64 32
# Must match the deployed domain (no trailing slash)
AUTH_URL=https://your-app.up.railway.app

# PostgreSQL (use Railway Postgres or Neon; run yarn db:migrate first)
DATABASE_URL=postgresql://user:password@host:5432/movienight

# Gemini AI chat (optional)
GOOGLE_API_KEY=your-gemini-api-key

# Socket.io CORS origin (must match the deployed domain)
CORS_ORIGIN=https://your-app.up.railway.app

# Optional, Railway sets this automatically
PORT=3000
